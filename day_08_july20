def timeConversion(s):
    period = s[-2:]      # AM or PM
    time = s[:-2]        # HH:MM:SS
    hour = int(time[:2])

    if period == "AM":
        if hour == 12:
            hour = 0
    else:  # PM
        if hour != 12:
            hour += 12

    return f"{hour:02d}" + time[2:]


if __name__ == '__main__':
    s = input()
    print(timeConversion(s))
